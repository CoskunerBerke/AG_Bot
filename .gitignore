# Gizli Anahtarlar ve Çevre Değişkenleri (ASLA GITHUB'A YÜKLENMEZ)
.env
*.env
*.key
*.pem

# Python & Sanal Ortam
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Veri & Önbellek (Büyük boyutlu ikili dosyalar)
.cache/
data/history/**/*.pkl
data/**/*.pkl

# Loglar ve Geçici Durumlar
logs/*.log
state/daily_state.json
state/positions.json
state/sim_account.json

# Ancak öğrenilmiş modeller ve alfa hisseleri GitHub'da saklanmalıdır:
!state/learned/
!state/pattern_weights.json

# IDE & İşletim Sistemi
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Eğitim videoları (büyük dosyalar, GitHub 100MB limitini aşar) — transkriptler repoda kalır
knowledge/**/*.mp4
knowledge/**/*.mkv
knowledge/**/*.webm

# Transkriptler üçüncü kişiye ait içerik — repo public olduğu sürece yüklenmez (STRATEGY_SPEC.md bizim özetimiz)
knowledge/transcript*.txt

# DMC çalışma çıktıları (sunucuda volume'de kalır)
state/dmc_live.json
state/dmc_live.tmp
state/dmc_journal.json
state/dmc_journal.tmp
state/dmc_ff_calendar.xml
logs/*.log*
reports/dmc_backtest_*.csv

# Çalışma çıktıları repoya girmez (eski bot raporları, haber önbelleği)
reports/*
!reports/.gitkeep
state/ff_calendar_cache.*

# Telegram oturumu ve indirilen kanal içeriği (yerelde kalır)
state/telegram/
*.session
*.session-journal

# Üye girişli Telegram grubundan türetilen test verisi (yerelde kalır)
knowledge/fixtures/kaan_telegram.yaml

# Tüm transkriptler (üçüncü kişiye ait içerik) — adları ne olursa olsun repoya girmez
knowledge/*.txt
knowledge/**/*.txt

# Claude Code yerel ayarları
.claude/
